# Lấy ở Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Trang quản trị /admin — đổi trước khi chạy thật
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SECRET=chuoi-ngau-nhien-dai
# Secret key của Supabase (chỉ dùng trên server) — có thì bài lưu vào bảng tutorials, không có thì lưu file data/tutorials.json
SUPABASE_SECRET_KEY=
